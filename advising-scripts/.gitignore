# Spreadsheets are generated, never tracked. Rebuild a requirements workbook
# from its .tsv:  make_requirements.py FILE.xlsx --from-tsv FILE.tsv
*.xlsx
*.xls

# Excel lock files
~$*

# Transcripts, and anything derived from one. A real transcript is a student
# record and must never enter this history. Generate a safe fake instead:
#   make_sample_transcript.py sample-transcript.pdf
*.pdf
output.txt
result.csv

# Scratch directories the checks create for themselves
_*_test/
scratch/

# Python
__pycache__/
*.pyc

# macOS
.DS_Store
